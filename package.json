    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.2",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
